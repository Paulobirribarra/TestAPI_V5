<!-- viwes/partials/card.ejs -->
<div class="card h-100 <%= factura ? (factura.pagada ? 'pagada' : '') + (factura.vencida ? ' vencida' : '') : '' %>">
    <div class="card-body">
        <% if (factura) { %>
            <h2 class="card-title">Folio: <%= factura.folio %></h2>
            <p class="card-text"><strong>Razón Social:</strong> <%= factura.razonSocial %></p>
            <p class="card-text"><strong>RUT Cliente:</strong> <%= factura.rutCliente %></p>
            <p class="card-text"><strong>Fecha Emisión:</strong> <%= factura.fechaEmision.toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }) %></p>
            <p class="card-text"><strong>Fecha Vencimiento:</strong> <%= factura.fechaVencimiento ? factura.fechaVencimiento.toLocaleDateString('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }) : 'No disponible' %></p>
            <p class="card-text"><strong>Monto Total:</strong> $<%= factura.montoTotal.toLocaleString() %></p>
            <p class="card-text"><strong>Estado:</strong> <%= factura.estado %></p>
            <% if (factura.tipoDTENumber === 61 && factura.folioDocReferencia) { %>
                <p class="card-text"><strong>Factura Anulada:</strong> <%= factura.folioDocReferencia %></p>
            <% } else if (factura.pagada && factura.numeroDeOperacion) { %>
                <p class="card-text"><strong>Número de Operación:</strong> <%= factura.numeroDeOperacion %></p>
            <% } %>

            <% if (user && user.role === 'admin') { %>
                <button class="btn btn-primary btn-ver-mas" data-bs-toggle="modal" data-bs-target="#modal-<%= factura._id %>">Ver más</button>
            <% } %>
        <% } else if (customContent) { %>
            <%- customContent %>
        <% } else { %>
            <p class="card-text">No hay datos disponibles.</p>
        <% } %>
    </div>
</div>

<% if (factura) { %>
    <!-- Modal -->
    <div class="modal fade" id="modal-<%= factura._id %>" tabindex="-1" aria-labelledby="modalLabel-<%= factura._id %>" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="modalLabel-<%= factura._id %>">Detalles de Factura - Folio <%= factura.folio %></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/factura/update/<%= factura._id %>" method="POST" class="row g-3">
                        <div class="col-12 form-group">
                            <label class="form-label"><strong>Estado de Pago:</strong></label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="pagada" id="pagada-<%= factura._id %>" <%= factura.pagada ? 'checked' : '' %>>
                                <label class="form-check-label status-text" for="pagada-<%= factura._id %>"><%= factura.pagada ? 'Pagada' : 'Pendiente' %></label>
                            </div>
                        </div>
                        <div class="col-12 form-group">
                            <label class="form-label"><strong>Método de Pago:</strong></label>
                            <input type="text" name="metodoDePago" value="<%= factura.metodoDePago || '' %>" class="form-control">
                        </div>
                        <% if (factura.tipoDTENumber === 61 && factura.folioDocReferencia) { %>
                            <div class="col-12 form-group">
                                <label class="form-label"><strong>Factura Anulada:</strong></label>
                                <input type="text" name="folioDocReferencia" value="<%= factura.folioDocReferencia || '' %>" class="form-control" readonly>
                                <small class="form-text text-muted">Folio de la factura anulada por esta nota de crédito.</small>
                            </div>
                        <% } else if (factura.pagada && factura.numeroDeOperacion) { %>
                            <div class="col-12 form-group">
                                <label class="form-label"><strong>Número de Operación:</strong></label>
                                <input type="text" name="numeroDeOperacion" value="<%= factura.numeroDeOperacion || '' %>" class="form-control" readonly>
                                <small class="form-text text-muted">Este campo se genera automáticamente según el comprobante de pago.</small>
                            </div>
                        <% } %>
                        <div class="col-12 form-group">
                            <label class="form-label"><strong>Comentario:</strong></label>
                            <input type="text" name="comentario" value="<%= factura.comentario || '' %>" class="form-control">
                        </div>
                        <div class="col-12 form-group">
                            <label class="form-label"><strong>Fecha de Pago:</strong></label>
                            <input type="date" name="fechaDePago" value="<%= factura.fechaDePago ? factura.fechaDePago.toISOString().split('T')[0] : '' %>" class="form-control">
                        </div>
                        <div class="col-12 form-group">
                            <label class="form-label"><strong>Contacto:</strong></label>
                            <input type="text" name="contacto" value="<%= factura.contacto || '' %>" class="form-control">
                        </div>
                        <div class="col-12 form-group">
                            <label class="form-label"><strong>Correo:</strong></label>
                            <input type="email" name="correoContacto" value="<%= factura.correoContacto || '' %>" class="form-control">
                        </div>
                        <div class="col-12 form-group">
                            <label class="form-label"><strong>Sector:</strong></label>
                            <input type="text" name="sector" value="<%= factura.sector || '' %>" class="form-control">
                        </div>
                        <div class="col-12 btn-group d-flex gap-2">
                            <button type="submit" class="btn btn-success btn-guardar">Guardar</button>
                            <button type="button" class="btn btn-secondary btn-cerrar" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
<% } %>

<script>
    function openModal(id) {
        const modal = document.getElementById(`modal-${id}`);
        modal.style.display = 'flex';
    }

    function closeModal(id) {
        const modal = document.getElementById(`modal-${id}`);
        modal.style.display = 'none';
    }

    // Cerrar modal al hacer clic fuera
    window.onclick = function(event) {
        if (event.target.className === 'modal') {
            event.target.style.display = 'none';
        }
    };
</script>