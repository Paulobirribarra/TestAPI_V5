<!-- views/partials/header.ejs -->
<header>
    <nav class="navbar">
        <div class="container">
            <div class="cabecera">
                <a href="/" class="logo">FacturasApp</a>
            </div>
            <ul class="nav-links">
                <% if (user) { %>
                    <li><a href="/">Ventas</a></li>
                    <li><a href="/compras">Compras</a></li>
                    <li><a href="/resumenMensual">Resumen Mensual</a></li>
                    <% if (user.role === 'admin') { %>
                        <li><a href="/consulta">Consultar Documentos</a></li>
                        <li><a href="/configuracion">Configuración</a></li>
                        <li><a href="/auth/register">Registrar Usuario</a></li>
                    <% } %>
                    <li><a href="/auth/logout">Cerrar Sesión (<%= user.name %>)</a></li>
                    <li class="nav-item">
                        <a class="nav-link" href="/facturas-compras">Facturas de Compras</a>
                    </li>
                <% } else { %>
                    <!-- <li><a href="/auth/login">Iniciar Sesión</a></li> -->
                <% } %>
            </ul>
        </div>
    </nav>
</header>