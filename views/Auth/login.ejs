<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Iniciar Sesión</title>
</head>
<body>
    <%- include('../partials/header') %>
    <main>
        <div class="auth-wrapper">
            <div class="auth-container card p-4 shadow-sm">
                <h1 class="card-title text-center mb-4">Iniciar Sesión</h1>
                <% if (message) { %>
                    <p class="error mb-3"><%= message %></p>
                <% } %>
                <% if (success) { %>
                    <p class="success mb-3"><%= success %></p>
                <% } %>
                <form action="/auth/login" method="POST" id="loginForm" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="email" class="form-label">Correo Electrónico:</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="ventas@c-ram.cl" required />
                    </div>
                    <div class="mb-3 position-relative">
                        <label for="password" class="form-label">Contraseña:</label>
                        <div class="password-container">
                            <input type="password" id="password" name="password" class="form-control" required />
                            <span class="toggle-password position-absolute end-0 top-50 translate-middle-y pe-3" onclick="togglePassword()">Mostrar</span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Iniciar Sesión</button>
                </form>
                <% if (showRegisterLink) { %>
                    <p class="text-center mt-3">
                        <a href="/auth/register" class="register-link btn btn-success">Registrar el primer usuario (Admin)</a>
                    </p>
                <% } %>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/auth.js"></script>
</body>
</html>