<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Registrar Usuario</title>
</head>
<body>
    <%- include('../partials/header') %>
    <main>
        <div class="auth-wrapper">
            <div class="auth-container card p-4 shadow-sm">
                <h1 class="card-title text-center mb-4">Registrar Nuevo Usuario</h1>
                <% if (isFirstUser) { %>
                    <p class="text-success mb-3">Este será el primer usuario y se registrará como administrador.</p>
                <% } %>
                <% if (error) { %>
                    <p class="error mb-3"><%= error %></p>
                <% } %>
                <form action="/auth/register" method="POST" id="registerForm" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="name" class="form-label">Nombre:</label>
                        <input type="text" id="name" name="name" class="form-control" value="<%= name %>" placeholder="Juan Pérez" required />
                        <span id="name-error" class="error"></span>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Correo Electrónico:</label>
                        <input type="email" id="email" name="email" class="form-control" value="<%= email %>" placeholder="example@test.cl" required />
                        <span id="email-error" class="error"></span>
                    </div>
                    <div class="mb-3 position-relative">
                        <label for="password" class="form-label">Contraseña:</label>
                        <div class="password-container">
                            <input type="password" id="password" name="password" class="form-control" placeholder="********" required />
                            <span class="toggle-password position-absolute end-0 top-50 translate-middle-y pe-3">Mostrar</span>
                        </div>
                        <span id="password-error" class="error"></span>
                    </div>
                    <div class="mb-3">
                        <label for="role" class="form-label">Rol:</label>
                        <select id="role" name="role" class="form-select" <% if (isFirstUser) { %> disabled <% } %>>
                            <option value="lector" <%= role === 'lector' ? 'selected' : '' %>>Lector</option>
                            <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Admin</option>
                        </select>
                        <% if (isFirstUser) { %>
                            <input type="hidden" name="role" value="admin">
                        <% } %>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Registrar</button>
                </form>
                <% if (!isFirstUser) { %>
                    <p class="text-center mt-3"><a href="/" class="btn btn-secondary">Volver al inicio</a></p>
                <% } %>
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/auth.js"></script>
</body>
</html>