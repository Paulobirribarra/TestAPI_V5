<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>Resumen Mensual - FacturasApp</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="flex-column">
    <%- include('partials/header') %>

    <div class="container mt-4">
        <h2 class="mb-4">Resumen Mensual</h2>

        <!-- Filtros -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-4">
                        <label for="year" class="form-label">Año</label>
                        <select class="form-select" id="year" name="year">
                            <option value="">Todos los años</option>
                            <% for(let y = new Date().getFullYear(); y >= 2020; y--) { %>
                                <option value="<%= y %>" <%= year == y ? 'selected' : '' %>><%= y %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="month" class="form-label">Mes</label>
                        <select class="form-select" id="month" name="month">
                            <option value="">Todos los meses</option>
                            <% const months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']; %>
                            <% months.forEach((m, i) => { %>
                                <option value="<%= i + 1 %>" <%= month == (i + 1) ? 'selected' : '' %>><%= m %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">Filtrar</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Totales Generales -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Totales Ventas</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1">Total Neto:</p>
                                <p class="mb-1">IVA:</p>
                                <p class="mb-0">Total:</p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-1">$<%= totales.ventas.neto.toLocaleString() %></p>
                                <p class="mb-1">$<%= totales.ventas.iva.toLocaleString() %></p>
                                <p class="mb-0 fw-bold">$<%= totales.ventas.total.toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Totales Compras</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1">Total Neto:</p>
                                <p class="mb-1">IVA Recuperable:</p>
                                <p class="mb-0">Total:</p>
                            </div>
                            <div class="col-6 text-end">
                                <p class="mb-1">$<%= totales.compras.neto.toLocaleString() %></p>
                                <p class="mb-1">$<%= totales.compras.ivaRecuperable.toLocaleString() %></p>
                                <p class="mb-0 fw-bold">$<%= totales.compras.total.toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Resúmenes -->
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Período</th>
                                <th class="text-end">Ventas Neto</th>
                                <th class="text-end">Ventas IVA</th>
                                <th class="text-end">Ventas Total</th>
                                <th class="text-end">Compras Neto</th>
                                <th class="text-end">Compras IVA</th>
                                <th class="text-end">Compras Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% resumenes.forEach(resumen => { %>
                                <tr>
                                    <td><%= resumen.periodo.substring(0, 4) %>-<%= resumen.periodo.substring(4) %></td>
                                    <td class="text-end">$<%= (resumen.ventas?.neto || 0).toLocaleString() %></td>
                                    <td class="text-end">$<%= (resumen.ventas?.iva || 0).toLocaleString() %></td>
                                    <td class="text-end">$<%= (resumen.ventas?.total || 0).toLocaleString() %></td>
                                    <td class="text-end">$<%= (resumen.compras?.neto || 0).toLocaleString() %></td>
                                    <td class="text-end">$<%= (resumen.compras?.ivaRecuperable || 0).toLocaleString() %></td>
                                    <td class="text-end">$<%= (resumen.compras?.total || 0).toLocaleString() %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script>
        document.getElementById('filtro-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const year = document.getElementById('year').value;
            const month = document.getElementById('month').value;
            window.location.href = `/resumen-mensual?year=${year}${month ? `&month=${month}` : ''}`;
        });
    </script>
</body>
</html>