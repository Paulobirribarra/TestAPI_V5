<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listado de Facturas</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include('partials/header') %>

    <main class="container">
        <h1>Listado de Facturas</h1>

        <section class="facturas">
            <a href="/notasDeCredito">Ver Notas de Crédito</a>

            <% if (facturas.length > 0) { %>
                <div class="factura-grid">
                    <% facturas.forEach(factura => { %>
                        <%- include('partials/card', { factura: factura }) %>
                    <% }) %>
                </div>

                <div class="pagination">
                    <% if (hasPrevPage) { %>
                        <a href="/?page=<%= currentPage - 1 %>" class="pagination-btn">Anterior</a>
                    <% } else { %>
                        <span class="pagination-btn disabled">Anterior</span>
                    <% } %>

                    <span>Página <%= currentPage %> de <%= totalPages %></span>

                    <% if (hasNextPage) { %>
                        <a href="/?page=<%= currentPage + 1 %>" class="pagination-btn">Siguiente</a>
                    <% } else { %>
                        <span class="pagination-btn disabled">Siguiente</span>
                    <% } %>
                </div>
            <% } else { %>
                <p>No hay facturas disponibles. <a href="/consulta">Consulta facturas</a> para agregar nuevas.</p>
            <% } %>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>