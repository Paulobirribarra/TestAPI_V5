<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuración - FacturasApp</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        /* Estilos adicionales para el formulario */
        #apiUser {
            background-color: #f0f0f0; /* Fondo gris claro para indicar que es readonly */
            cursor: not-allowed; /* Cursor que indica no editable */
        }
        #apiKey {
            font-family: monospace; /* Fuente monoespaciada para la API Key */
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main class="container">
        <h1>Configuración</h1>
        <form id="config-form">
            <label for="apiUser">Usuario API:</label>
            <input type="text" id="apiUser" name="apiUser" value="api" required readonly />

            <label for="apiKey">API Key:</label>
            <input 
                type="password" 
                id="apiKey" 
                name="apiKey" 
                placeholder="Ej: ABC123-xyz789" 
                required 
            />

            <button type="submit">Guardar Configuración</button>
        </form>

        <div id="mensajeExito" style="display:none; background-color: #28a745; color: white; padding: 10px; margin-top: 20px; text-align: center; border-radius: 5px;">
            ✅ Configuración guardada con éxito
        </div>
        <div id="mensajeError" style="display:none; background-color: #dc3545; color: white; padding: 10px; margin-top: 20px; text-align: center; border-radius: 5px;">
            ❌ Error al guardar la configuración
        </div>
    </main>

    <script>
        document.getElementById('config-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const apiUser = document.getElementById('apiUser').value;
            const apiKey = document.getElementById('apiKey').value;

            try {
                const response = await fetch('/api/config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ apiUser, apiKey })
                });

                if (response.ok) {
                    document.getElementById('mensajeExito').style.display = 'block';
                    document.getElementById('mensajeError').style.display = 'none';
                    document.getElementById('apiKey').value = ''; // Limpiar el campo tras guardar
                } else {
                    throw new Error('Error en la respuesta del servidor');
                }
            } catch (error) {
                console.error('Error:', error);
                document.getElementById('mensajeExito').style.display = 'none';
                document.getElementById('mensajeError').style.display = 'block';
            }
        });
    </script>

    <%- include('partials/footer') %>
</body>
</html>